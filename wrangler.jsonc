/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "d1-rest2",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-03",
    "d1_databases": [
        {
          "binding": "DB",
          "database_name": "news_db_cms_originaux",
          "database_id": "f9012ebc-7a9d-4b93-81d9-4eac600c40d2"
        }
    ],
    "secrets_store_secrets": [
        {
            "store_id": "fd0236b6bb2f4ae9b79a46c8c549110d",
            "binding": "SECRET",
            "secret_name": "secret"
        }
    ],
	"observability": {
		"enabled": true
	}
}
